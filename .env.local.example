# ─────────────────────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_anon_public_키

# ⚠ 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것 (서버 전용, 브라우저에 노출되면 안 됨)
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키

# ─────────────────────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > Database > Connection string > URI
# [YOUR-PASSWORD] 부분을 실제 DB 비밀번호로 교체
# → `npm run db:setup` 이 이 값으로 스키마를 자동 적용한다. Vercel 에는 넣지 않아도 됨.
# ─────────────────────────────────────────────────────────────
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ─────────────────────────────────────────────────────────────
# 컨트롤 페이지 비밀 키 (아무 긴 랜덤 문자열)
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ─────────────────────────────────────────────────────────────
CONTROL_KEY=여기에_긴_랜덤_문자열
